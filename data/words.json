general","lvl":3},{"id":"w46","w":"consequence","pos":"n","tr":"последствие","def":"a result of an action","ex":"Climate change has serious consequences.","topic":"general","lvl":1},{"id":"w47","w":"considerable","pos":"adj","tr":"значительный","def":"large in amount or importance","ex":"He spent a considerable amount of money.","topic":"general","lvl":2},{"id":"w48","w":"consistent","pos":"adj","tr":"последовательный, стабильный","def":"always behaving or happening in the same way","ex":"Her results have been consistent.","topic":"academic","lvl":2},{"id":"w49","w":"constitute","pos":"v","tr":"составлять","def":"to be or form a part of something","ex":"Women constitute 60% of the workforce.","topic":"academic","lvl":3},{"id":"w50","w":"constraint","pos":"n","tr":"ограничение","def":"something that limits what you can do","ex":"Budget constraints delayed the project.","topic":"economy","lvl":3},{"id":"w51","w":"contemporary","pos":"adj","tr":"современный","def":"belonging to the present time","ex":"Contemporary art is often controversial.","topic":"culture","lvl":2},{"id":"w52","w":"contradict","pos":"v","tr":"противоречить","def":"to say the opposite of something","ex":"The new evidence contradicts his story.","topic":"academic","lvl":2},{"id":"w53","w":"contribute","pos":"v","tr":"вносить вклад","def":"to give something to help achieve a result","ex":"Exercise contributes to good health.","topic":"general","lvl":1},{"id":"w54","w":"controversial","pos":"adj","tr":"спорный","def":"causing disagreement","ex":"The decision was highly controversial.","topic":"society","lvl":2},{"id":"w55","w":"convenient","pos":"adj","tr":"удобный","def":"easy to use or suitable","ex":"The hotel has a convenient location.","topic":"general","lvl":1},{"id":"w56","w":"convince","pos":"v","tr":"убеждать","def":"to make someone believe something","ex":"She convinced him to apply.","topic":"general","lvl":1},{"id":"w57","w":"crucial","pos":"adj","tr":"решающий","def":"extremely important",